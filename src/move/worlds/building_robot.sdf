<?xml version="1.0"?>
<sdf version="1.8">
  <world name="car_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="libgz-sim-sensors-system.so" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="libgz-sim-imu-system.so" name="gz::sim::systems::Imu" />
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <!-- Single source of truth for the robot: models/vehicle_blue/model.sdf. Resolved via GZ_SIM_RESOURCE_PATH, set in launch/sim.launch.py -->
    <include>
      <uri>model://vehicle_blue</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>
    <!-- Obstacles. Without something in range the gpu_lidar returns inf on every
         beam and RViz has nothing to draw, so the testbed looks broken. -->
    <model name="wall_front">
      <static>true</static>
      <pose>6 0 1 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.5 6 2</size></box></geometry>
          <!-- Weak lidar return: the barrier is meant to look like dust, not
               a hard obstacle. gz-sensors maps laser_retro -> point intensity. -->
          <laser_retro>0</laser_retro>
          <transparency>0.7</transparency>
          <material>
            <ambient>0.6 0.6 0.6 0.3</ambient>
            <diffuse>0.6 0.6 0.6 0.3</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.5 6 2</size></box></geometry>
        </collision>
      </link>
    </model>
    <model name="pillar_left">
      <static>true</static>
      <pose>4 2.5 0.75 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.3</radius><length>1.5</length></cylinder></geometry>
          <!-- Retroreflective: the poles come back hot in the intensity field.
               2000 is gz-sensors' maximum; higher values are clamped to it. -->
          <laser_retro>2000</laser_retro>
          <material>
            <ambient>0.8 0.4 0.1 1</ambient>
            <diffuse>0.8 0.4 0.1 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry><cylinder><radius>0.3</radius><length>1.5</length></cylinder></geometry>
        </collision>
      </link>
    </model>
  </world>
</sdf>
